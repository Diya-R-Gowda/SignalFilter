# Copy this file to .env and fill in the values.
# See the root README.md "Setup" section for how to get each one.

DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/signalfilter

SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_THRESHOLD=0.0
INTERRUPT_SCORE_THRESHOLD=4
GMAIL_INTERRUPT_SCORE_THRESHOLD=7
